# HD2Lab Market Intelligence · 환경 변수 예시
# 이 파일은 형식만 보여준다. 실제 값은 서버의 /etc/hd2lab/market-intelligence.env
# (0600, 전용 사용자 소유)에 두고 Git·이미지·로그에 남기지 않는다.

# 무료 OpenDART 개인 키(40자). 비워 두면 공시는 표본 모드로 폴백한다.
OPENDART_API_KEY=

# 1이면 어떤 외부 요청도 보내지 않고 표본 데이터만 사용한다(오프라인 검증용).
MI_OFFLINE=0

# Nginx 뒤 서브패스로 붙일 때. 예: /market-intel
MI_ROOT_PATH=/market-intel

# CORS 허용 출처(쉼표 구분). 정적 프런트는 https://hyangdan2.github.io/PKPilot0004/ 에서
# 이 API 를 호출한다. 비우면 기본값(hyangdan2.github.io + 로컬 포트)을 쓴다.
# 로컬 정적 서버로 화면을 볼 때는 그 포트를 추가한다(예: http://127.0.0.1:8804).
MI_CORS_ORIGINS=https://hyangdan2.github.io,http://localhost:8791,http://127.0.0.1:8791

# 외부 무료 API 타임아웃(초). 느린 소스는 폴백으로 넘어간다.
MI_HTTP_TIMEOUT=6

# 뉴스 검색 기간(일)과 공시 조회 기간(일).
MI_NEWS_DAYS=14
MI_DISCLOSURE_DAYS=30
