<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#FAFAFD">
    <title>{% if categoryPage %}{{ categoryPage.name }} · {% elif title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or summary or site.description }}">
    <meta property="og:type" content="{% if page.url and page.url.includes('/posts/') %}article{% else %}website{% endif %}">
    <meta property="og:site_name" content="HD2Lab · {{ site.name }}">
    <meta property="og:title" content="{% if categoryPage %}{{ categoryPage.name }} · {% elif title %}{{ title }} · {% endif %}{{ site.name }}">
    <meta property="og:description" content="{{ description or summary or site.tagline }}">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg?v=20261116-softiris">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png?v=20261116-softiris">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png?v=20261106">
    <script>try{var h=localStorage.getItem('hd2-theme');document.documentElement.setAttribute('data-theme',h==='dark'?'dark':'light');}catch(e){document.documentElement.setAttribute('data-theme','light');}</script>
    <link rel="stylesheet" href="/assets/hd2-theme.css?v=20261117-navy">
    <script src="/assets/hd2-theme.js?v=20261117-navy" defer></script>
    <link rel="stylesheet" href="{{ '/assets/diary.css' | url }}?v=20261118-accordion">
</head>
<body class="page-{{ page.url | slugify }}">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="{{ '/' | url }}" aria-label="{{ site.name }} home">
                <span class="mark" aria-hidden="true"></span>
                <span class="brand-name">{{ site.brand }}</span>
                <em>{{ site.name }}</em>
            </a>
            {# which Diary link is the current one: Top on /diary/, the category elsewhere #}
            {% set diaryHome = '/' %}
            {% set diarySub = 'top' if page.url == diaryHome else (categoryPage.slug if categoryPage else (categorySlug if categorySlug else '')) %}
            <nav class="header-nav" aria-label="Hub categories">
                <a class="nav-tab" href="https://hyangdan2.github.io/">Web-HQ</a>
                <a class="nav-tab" href="https://hyangdan2.github.io/ApplicationHub/">Apps</a>
                <a class="nav-tab" href="https://hyangdan2.github.io/GameHub/">Play</a>
                <a class="nav-tab" href="https://hyangdan2.github.io/TechnicalHub/">Tech</a>
                <div class="nav-dropdown">
                    <a class="nav-tab nav-dropdown-trigger is-current" href="https://hyangdan2.github.io/diary/" aria-current="page">Diary<span class="nav-caret" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 10 10" focusable="false"><path d="M1.8 3.5 5 6.7l3.2-3.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
                    <div class="nav-dropdown-panel">
                        <a class="nav-dropdown-link{% if diarySub == 'top' %} is-current{% endif %}" href="https://hyangdan2.github.io/diary/"{% if diarySub == 'top' %} aria-current="page"{% endif %}>Top</a>
                        <a class="nav-dropdown-link{% if diarySub == 'devlog' %} is-current{% endif %}" href="https://hyangdan2.github.io/diary/categories/devlog/"{% if diarySub == 'devlog' %} aria-current="page"{% endif %}>Devlog</a>
                        <a class="nav-dropdown-link{% if diarySub == 'architecture' %} is-current{% endif %}" href="https://hyangdan2.github.io/diary/categories/architecture/"{% if diarySub == 'architecture' %} aria-current="page"{% endif %}>Architecture</a>
                        <a class="nav-dropdown-link{% if diarySub == 'troubleshooting' %} is-current{% endif %}" href="https://hyangdan2.github.io/diary/categories/troubleshooting/"{% if diarySub == 'troubleshooting' %} aria-current="page"{% endif %}>Troubleshooting</a>
                        <a class="nav-dropdown-link{% if diarySub == 'notes' %} is-current{% endif %}" href="https://hyangdan2.github.io/diary/categories/notes/"{% if diarySub == 'notes' %} aria-current="page"{% endif %}>Notes</a>
                    </div>
                </div>
                <a class="nav-tab" href="https://hyangdan2.github.io/about/">About</a>
            </nav>
            <div class="header-actions">
                <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M3 5.5H17M3 10H17M3 14.5H17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <div class="drawer-backdrop" hidden></div>
    <aside id="mobile-drawer" class="mobile-drawer" aria-label="Hub navigation" aria-hidden="true">
        <div class="drawer-head">
            <span class="drawer-title"><span class="mark mark-sm" aria-hidden="true"></span><span>Navigation</span></span>
            <button class="drawer-close" type="button" aria-label="Close menu">&times;</button>
        </div>
        <nav class="drawer-list" aria-label="Hub categories">
            <a class="drawer-item" href="https://hyangdan2.github.io/">Web-HQ</a>
            <a class="drawer-item" href="https://hyangdan2.github.io/ApplicationHub/">Apps</a>
            <a class="drawer-item" href="https://hyangdan2.github.io/GameHub/">Play</a>
            <a class="drawer-item" href="https://hyangdan2.github.io/TechnicalHub/">Tech</a>
            {# the Diary group starts open on every Diary page #}
            <div class="drawer-group is-open" data-drawer-group="diary">
                <div class="drawer-row">
                    <a class="drawer-item is-current" href="https://hyangdan2.github.io/diary/" aria-current="page">Diary</a>
                    <button class="drawer-toggle" type="button" aria-expanded="true" aria-controls="drawer-diary-sub" aria-label="Diary sections">
                        <span class="drawer-caret" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" focusable="false"><path d="M2.4 4.3 6 7.9l3.6-3.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    </button>
                </div>
                <div class="drawer-sub" id="drawer-diary-sub">
                    <div class="drawer-sub-inner">
                        <a class="drawer-subitem{% if diarySub == 'top' %} is-current{% endif %}" href="https://hyangdan2.github.io/diary/"{% if diarySub == 'top' %} aria-current="page"{% endif %}>Top</a>
                        <a class="drawer-subitem{% if diarySub == 'devlog' %} is-current{% endif %}" href="https://hyangdan2.github.io/diary/categories/devlog/"{% if diarySub == 'devlog' %} aria-current="page"{% endif %}>Devlog</a>
                        <a class="drawer-subitem{% if diarySub == 'architecture' %} is-current{% endif %}" href="https://hyangdan2.github.io/diary/categories/architecture/"{% if diarySub == 'architecture' %} aria-current="page"{% endif %}>Architecture</a>
                        <a class="drawer-subitem{% if diarySub == 'troubleshooting' %} is-current{% endif %}" href="https://hyangdan2.github.io/diary/categories/troubleshooting/"{% if diarySub == 'troubleshooting' %} aria-current="page"{% endif %}>Troubleshooting</a>
                        <a class="drawer-subitem{% if diarySub == 'notes' %} is-current{% endif %}" href="https://hyangdan2.github.io/diary/categories/notes/"{% if diarySub == 'notes' %} aria-current="page"{% endif %}>Notes</a>
                    </div>
                </div>
            </div>
            <a class="drawer-item" href="https://hyangdan2.github.io/about/">About</a>
        </nav>
    </aside>

    <main id="main">
        {{ content | safe }}
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <span>© {{ site.year }} {{ site.brand }}</span>
            <span class="footer-note">++ BUILD NOTES ++ KEEP SHIPPING ++</span>
            <a href="{{ site.hqUrl }}">{{ site.hqLabel }} <span aria-hidden="true">↗</span></a>
        </div>
    </footer>
    {% if pageScript %}<script src="{{ pageScript | url }}" defer></script>{% endif %}
    <script src="{{ '/assets/diary-nav.js' | url }}?v=20261118-accordion" defer></script>
</body>
</html>
